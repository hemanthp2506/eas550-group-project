# Copy to .env and fill in the values. .env is git-ignored; never commit real credentials.
#
# Option A: a full connection string (for example a Neon connection string).
# When set, it takes precedence over the PG* variables below.
DATABASE_URL=

# Option B: standard libpq variables. Also read by docker-compose.yml (local PostgreSQL) and psql.
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=
